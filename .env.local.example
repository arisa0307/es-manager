# Project Settings → API からコピー
# URL は https://xxxxxxxx.supabase.co のみ（/rest/v1 は付けない）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon public キー（eyJ で始まる長い文字列）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# アプリの公開URL（iCal購読URLの生成に使用）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# サーバー専用: iCal配信用（Supabase Dashboard > Settings > API）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# サーバー専用: 「今日の推奨アクション」のAI要約に使用（未設定ならルールベースのみ動作）
# キーは https://aistudio.google.com/apikey で発行
GEMINI_API_KEY=
# 任意。未設定なら gemini-flash-latest を使用
GEMINI_MODEL=
